        <mxCell id="_dGVXtFYWZ1XbbZ8Xn8D-37" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;line&quot;&gt;&lt;div class=&quot;line&quot;&gt;secure_vector&amp;lt;uint8_t&amp;gt; mul_x_only(const AffinePoint&amp;amp; pt,&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;const Scalar&amp;amp; scalar,&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;RandomNumberGenerator&amp;amp; rng) const override {&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;auto tbl = WindowedBoothMulTable&amp;lt;C, VarPointWindowBits&amp;gt;(from_stash(pt));&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;auto result = tbl.mul(from_stash(scalar), rng);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
