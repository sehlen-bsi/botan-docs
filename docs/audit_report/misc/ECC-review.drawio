        <mxCell id="_dGVXtFYWZ1XbbZ8Xn8D-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;line&quot;&gt;   &lt;a class=&quot;code hl_typedef&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1WindowedBoothMulTable.html#a0b12d8d4e11cc0820405a917aa88f720&quot;&gt;ProjectivePoint&lt;/a&gt; &lt;a class=&quot;code hl_function&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1WindowedBoothMulTable.html#ab6a5b5cda86d4df787eaa0ce85b5ea10&quot;&gt;mul&lt;/a&gt;(&lt;span class=&quot;keyword&quot;&gt;const&lt;/span&gt; &lt;a class=&quot;code hl_typedef&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1WindowedBoothMulTable.html#a17425d97a9ef22a728ff2afc352aef31&quot;&gt;Scalar&lt;/a&gt;&amp;amp; s, RandomNumberGenerator&amp;amp; &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#a838f4d4451f27c8322d8434779828ac6&quot;&gt;rng&lt;/a&gt;)&lt;span class=&quot;keyword&quot;&gt; const &lt;/span&gt;{&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&lt;span class=&quot;keyword&quot;&gt;const&lt;/span&gt; &lt;a class=&quot;code hl_class&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1BlindedScalarBits.html&quot;&gt;BlindedScalar&lt;/a&gt; &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#acbf847dcf710005795c5bd18dd0c7f3e&quot;&gt;bits&lt;/a&gt;(s, &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#a838f4d4451f27c8322d8434779828ac6&quot;&gt;rng&lt;/a&gt;);&lt;/div&gt;" vertex="1">
