        <mxCell id="_dGVXtFYWZ1XbbZ8Xn8D-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;line&quot;&gt;      &lt;a class=&quot;code hl_class&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1PCurve_1_1GenericProjectivePoint.html&quot;&gt;GenericProjectivePoint&lt;/a&gt; &lt;a class=&quot;code hl_function&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1PCurve_1_1anonymous__namespace_02pcurves__generic_8cpp_03_1_1GenericWindowedMul.html#a4e52e976a7fc9a6933735090497cf576&quot;&gt;mul&lt;/a&gt;(&lt;span class=&quot;keyword&quot;&gt;const&lt;/span&gt; &lt;a class=&quot;code hl_class&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1PCurve_1_1GenericScalar.html&quot;&gt;GenericScalar&lt;/a&gt;&amp;amp; s, RandomNumberGenerator&amp;amp; rng) {&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&lt;a id=&quot;l01320&quot; name=&quot;l01320&quot;&gt;&lt;/a&gt;         &lt;span class=&quot;keyword&quot;&gt;const&lt;/span&gt; &lt;a class=&quot;code hl_class&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1PCurve_1_1anonymous__namespace_02pcurves__generic_8cpp_03_1_1GenericBlindedScalarBits.html&quot;&gt;GenericBlindedScalarBits&lt;/a&gt; &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#acbf847dcf710005795c5bd18dd0c7f3e&quot;&gt;bits&lt;/a&gt;(s, &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#a838f4d4451f27c8322d8434779828ac6&quot;&gt;rng&lt;/a&gt;, WindowBits);&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&lt;span class=&quot;keywordflow&quot;&gt;return&lt;/span&gt; varpoint_exec&amp;lt;GenericCurve, WindowBits&amp;gt;(m_table, &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#acbf847dcf710005795c5bd18dd0c7f3e&quot;&gt;bits&lt;/a&gt;, &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#a838f4d4451f27c8322d8434779828ac6&quot;&gt;rng&lt;/a&gt;);&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&lt;a id=&quot;l01323&quot; name=&quot;l01323&quot;&gt;&lt;/a&gt;      }&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="350" x="160" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="_dGVXtFYWZ1XbbZ8Xn8D-30" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;line&quot;&gt;&lt;span class=&quot;keyword&quot;&gt;&lt;a class=&quot;code hl_function&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1PCurve_1_1anonymous__namespace_02pcurves__generic_8cpp_03_1_1GenericBlindedScalarBits.html#ac5c91967729d0f7aaa324899365d4bda&quot;&gt;GenericBlindedScalarBits&lt;/a&gt;(&lt;span class=&quot;keyword&quot;&gt;const&lt;/span&gt; &lt;a class=&quot;code hl_class&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/classBotan_1_1PCurve_1_1GenericScalar.html&quot;&gt;GenericScalar&lt;/a&gt;&amp;amp; scalar, RandomNumberGenerator&amp;amp; rng, &lt;span class=&quot;keywordtype&quot;&gt;size_t&lt;/span&gt; wb) {&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&lt;span class=&quot;keyword&quot;&gt;[...]&lt;/span&gt;&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&lt;span class=&quot;keyword&quot;&gt;const&lt;/span&gt; &lt;span class=&quot;keywordtype&quot;&gt;size_t&lt;/span&gt; blinder_bits = &lt;a class=&quot;code hl_function&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#a31069a565c6e733549e9846a15abd7f0&quot;&gt;scalar_blinding_bits&lt;/a&gt;(order_bits);&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&lt;span class=&quot;keywordflow&quot;&gt;if&lt;/span&gt;(blinder_bits &amp;gt; 0 &amp;amp;&amp;amp; &lt;a class=&quot;code hl_variable&quot; href=&quot;file:///home/fstrenzke/dev/p663/botan/doxygen/html/namespaceBotan.html#a838f4d4451f27c8322d8434779828ac6&quot;&gt;rng&lt;/a&gt;.is_seeded()) {&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="410" x="220" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="_dGVXtFYWZ1XbbZ8Xn8D-31" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;line&quot;&gt;&lt;div class=&quot;line&quot;&gt;constexpr size_t scalar_blinding_bits(size_t scalar_bits) {&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&amp;nbsp; // For blinding use 1/8 the order length for most curves; for P-521 we round down a bit&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&amp;nbsp; // so the masked scalar fits exactly in 9 or 18 words.&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&amp;nbsp; if(scalar_bits == 521) {&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&amp;nbsp; &amp;nbsp; return 55;&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&amp;nbsp; } else {&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&amp;nbsp; &amp;nbsp; return scalar_bits / 8;&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;&amp;nbsp; }&lt;/div&gt;&lt;div class=&quot;line&quot;&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="370" x="210" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="_dGVXtFYWZ1XbbZ8Xn8D-32" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" value="Problem:&lt;br&gt;implicit choice of blinding dep. on whether RNG is seeded" vertex="1">
          <mxGeometry height="80" width="120" x="550" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="_dGVXtFYWZ1XbbZ8Xn8D-33" parent="1" style="ellipse;whiteSpace=wrap;html=1;" value="256 bit curve =&amp;gt; 32 bits blinding&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;AIS: &quot;&lt;span style=&quot;background-color: transparent;&quot;&gt;The size of the blinding factor r depends on the used curve. In [SW14] it is shown that for some&lt;/span&gt;&lt;/div&gt;&lt;div&gt;curves not even 64 bits blinding are sufcient, depending on the error rate of the measurements.&quot;&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="310" x="580" y="1460" as="geometry" />
        </mxCell>
